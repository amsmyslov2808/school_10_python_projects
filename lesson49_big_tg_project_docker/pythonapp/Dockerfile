# Берём компактный официальный образ с нужной версией Python.
FROM python:3.10.6-slim

# Все следующие команды выполняются в каталоге приложения.
WORKDIR /app

# Сначала устанавливаем зависимости отдельным слоем для эффективного кеширования.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Копируем исходный код приложения в образ.
COPY . .

# Команда запуска по умолчанию (в docker-compose она дополнена флагом -u).
CMD ["python", "main.py"]
